# --- Database (Neon serverless Postgres) -------------------------------------
# Pooled connection string (-pooler host). The @neondatabase/serverless driver
# talks HTTPS to this; used by the app at runtime.
# Get yours with: neon env pull   (writes .env.local)
DATABASE_URL=

# Direct (unpooled) connection string. Optional: only `npm run db:setup` uses it,
# because DDL should run on the direct endpoint, not the PgBouncer-pooled one.
DATABASE_URL_UNPOOLED=

# --- LLM provider (Gemini native API, search-grounded — see lib/llm.ts) ------
# The seam (postChatCompletion in lib/llm.ts) speaks Google's NATIVE
# generateContent API with the google_search tool. Google's OpenAI-compatible
# layer CANNOT enable search grounding (any tool spelling is a 400), and a
# model prompted to "search the web" without the tool returns empty
# MALFORMED_FUNCTION_CALL responses or 400s — so native is required here.
# Key: https://aistudio.google.com/apikey (AI Studio key starts with "AIza")
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.8-flash

# --- Web Push (VAPID) ---------------------------------------------------------
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address pushed to browsers, e.g. "mailto:founder@example.com"
VAPID_SUBJECT=

# --- Scheduling ---------------------------------------------------------------
# Shared secret; Vercel Cron requests must send `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
