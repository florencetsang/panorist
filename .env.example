# --- Database (Neon serverless Postgres) -------------------------------------
# Pooled connection string (-pooler host). The @neondatabase/serverless driver
# talks HTTPS to this; used by the app at runtime.
# Get yours with: neon env pull   (writes .env.local)
DATABASE_URL=

# Direct (unpooled) connection string. Optional: only `npm run db:setup` uses it,
# because DDL should run on the direct endpoint, not the PgBouncer-pooled one.
DATABASE_URL_UNPOOLED=

# --- LLM provider (Gemini native API, search-grounded — see lib/llm.ts) ------
# The seam (postChatCompletion in lib/llm.ts) speaks Google's NATIVE
# generateContent API with the google_search tool. Google's OpenAI-compatible
# layer CANNOT enable search grounding (any tool spelling is a 400), and a
# model prompted to "search the web" without the tool returns empty
# MALFORMED_FUNCTION_CALL responses or 400s — so native is required here.
# Key: https://aistudio.google.com/apikey (AI Studio key starts with "AIza")
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.8-flash

# --- Web Push (VAPID) ---------------------------------------------------------
# Keypair from: npm run vapid:generate   (wraps `web-push generate-vapid-keys`)
# Paste the pair here, AND set all three VAPID_* values in the Vercel
# dashboard (redeploy afterwards) — deployed functions read env vars from
# there, not from this file. The private key never leaves the server; the
# public one is handed to browsers via GET /api/push/subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address pushed to browsers, e.g. "mailto:founder@example.com"
VAPID_SUBJECT=

# --- Scheduling ---------------------------------------------------------------
# Shared secret guarding the cron entry point and the expensive /api/generate
# worker. Vercel Cron hits /api/cron with `Authorization: Bearer <CRON_SECRET>`
# automatically once this is set on the deployment; the cron route forwards it
# as x-cron-secret when calling /api/generate.
CRON_SECRET=

# --- Prototype identity (frontend, TODO(auth)) ----------------------------------
# NO real auth exists in the prototype: pages act as the ?userId= query param
# user, falling back to this id (the seeded test@example.com user).
# Find yours with: SELECT id FROM users WHERE email = 'test@example.com';
NEXT_PUBLIC_TEST_USER_ID=
