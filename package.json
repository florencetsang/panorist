{
  "name": "panorist",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @panorist/web",
    "dev:mobile": "npm run start -w @panorist/mobile",
    "build": "npm run build -w @panorist/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w @panorist/web",
    "db:setup": "npm run db:setup -w @panorist/web",
    "db:migrate:prod": "npm run db:migrate:prod -w @panorist/web",
    "db:setup:prod": "npm run db:setup:prod -w @panorist/web"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.1.0",
    "@neon/config": "^1.8.3"
  }
}
