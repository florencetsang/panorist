{
  "info": {
    "name": "Panorist API",
    "description": "Every Panorist API route. Set the collection variables first:\n\n- `baseUrl`: e.g. http://localhost:3000 (`npm run dev`) or your Vercel production URL.\n- `email` / `password`: an existing, verified Panorist account (sign up in the web app first).\n- `cronSecret`: the `CRON_SECRET` value; only the Jobs requests need it.\n- `userId`: an app user uuid (`users.id`); only Generate needs it.\n\nAuth: user routes take the user from the session, never from input. Run **Auth → Sign in** (stores `sessionToken`), then **Auth → Get JWT** (stores `jwt`). Every other request sends `Authorization: Bearer {{jwt}}` (collection-level auth), the same way the mobile app does. The JWT lasts 15 minutes; run Get JWT again when requests start returning 401. (In a browser, the web app authenticates with its session cookie instead.)\n\nCaution: Generate and Cron call the LLM (costs money) and send real pushes. \"Store push subscription\" saves a FAKE subscription; run \"Clear push subscription\" afterwards.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "test@example.com"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "sessionToken",
      "value": ""
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "cronSecret",
      "value": ""
    },
    {
      "key": "userId",
      "value": "b19d6a47-bc86-43da-b963-88da91383ea8"
    },
    {
      "key": "reportId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Neon Auth (Better Auth) endpoints, proxied by /api/auth/*.",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Sign in (email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.response.headers.get('set-auth-token') || (pm.response.json() || {}).token;",
                  "if (token) pm.collectionVariables.set('sessionToken', token);",
                  "pm.test('signed in', () => pm.expect(token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-in", "email"]
            }
          }
        },
        {
          "name": "Get JWT",
          "description": "Reads the session with the session token; the JWT arrives in the `set-auth-jwt` response header.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jwt = pm.response.headers.get('set-auth-jwt');",
                  "if (jwt) pm.collectionVariables.set('jwt', jwt);",
                  "pm.test('got a JWT', () => pm.expect(jwt).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/get-session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "get-session"]
            }
          }
        },
        {
          "name": "Sign out",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-out",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-out"]
            }
          }
        }
      ]
    },
    {
      "name": "Preferences",
      "item": [
        {
          "name": "Get preferences",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "preferences"]
            },
            "description": "The user joined with their preferences."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test('has categories', () => pm.expect(pm.response.json()).to.have.property('dailyCategories'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update preferences",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "preferences"]
            },
            "description": "Partial update; returns the stored row. Allowed patch fields: deliveryHour (0–23), dailyCategories, weeklyCategories (arrays of: world, asia_pacific, hong_kong, economics, sport, entertainment, lifestyle, technology), pushSubscription (object or null). Unknown fields → 400. Both lists empty = paused.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patch\": {\n    \"deliveryHour\": 8,\n    \"dailyCategories\": [\n      \"world\",\n      \"economics\"\n    ],\n    \"weeklyCategories\": [\n      \"hong_kong\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update preferences — invalid field (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "preferences"]
            },
            "description": "Negative case: unknown patch keys are rejected.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patch\": {\n    \"frequency\": \"daily\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.expect(pm.response.code).to.be.oneOf([400]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Preferences without auth (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "preferences"]
            },
            "description": "Negative case: no session or bearer token → 401.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.expect(pm.response.code).to.be.oneOf([400]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "List reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"]
            },
            "description": "Recent reports, newest first. `content` holds cache pointers {category, frequency, to}. `readAt` is null while unread. Saves the newest id as {{reportId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test('is an array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "const first = pm.response.json()[0]; if (first) pm.collectionVariables.set('reportId', first.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List reports (hydrated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports?hydrate=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"],
              "query": [
                {
                  "key": "hydrate",
                  "value": "1"
                }
              ]
            },
            "description": "Same rows, plus `topics`: [{category, markdown}] resolved from the markdown cache."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one report (rendered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Mark report read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"]
            },
            "description": "Set read status (read: true/false); returns {id, readAt}. Marking read keeps the first readAt. Run \"List reports\" first to fill {{reportId}}. 404 if the report isn't the user's.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportId\": \"{{reportId}}\",\n  \"read\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark report read — bad reportId (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"]
            },
            "description": "Negative case: reportId must be a numeric string.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportId\": \"abc\",\n  \"read\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.expect(pm.response.code).to.be.oneOf([400]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Push",
      "item": [
        {
          "name": "Get VAPID public key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/push/subscribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "push", "subscribe"]
            },
            "description": "Public key the browser needs for PushManager.subscribe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Store push subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/push/subscribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "push", "subscribe"]
            },
            "description": "Stores a push subscription (204). This sample is FAKE (valid shape, unreachable endpoint), so later pushes to it fail. Run \"Clear push subscription\" afterwards.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscription\": {\n    \"endpoint\": \"https://fcm.googleapis.com/fcm/send/postman-test-endpoint\",\n    \"expirationTime\": null,\n    \"keys\": {\n      \"p256dh\": \"BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM\",\n      \"auth\": \"tBHItJI5svbpez7KI4CCXg\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', () => pm.expect(pm.response.code).to.be.oneOf([204]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Clear push subscription",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "preferences"]
            },
            "description": "Removes the stored subscription (pushSubscription: null).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patch\": {\n    \"pushSubscription\": null\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Delete account (DESTRUCTIVE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/account",
              "host": ["{{baseUrl}}"],
              "path": ["api", "account"]
            },
            "description": "Permanently deletes the signed-in account: preferences, reports and the Neon Auth user (sessions included). Answers 204. Only run against a throwaway account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', () => pm.expect(pm.response.code).to.equal(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Jobs (need cronSecret)",
      "item": [
        {
          "name": "Generate reports for user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-cron-secret",
                "value": "{{cronSecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "generate"]
            },
            "description": "Per-user worker. Generates the reports due now for the user's local date (daily always, weekly on local Monday), ignoring delivery hour. 201 {dailyReportId, weeklyReportId}; 200 with nulls when nothing is due (paused); 502 when every category failed. Idempotent: re-running returns the same ids and sends no second push. Calls the LLM and sends pushes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate — missing secret (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "generate"]
            },
            "description": "Negative case: no x-cron-secret header.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.expect(pm.response.code).to.be.oneOf([401]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Run cron tick",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{cronSecret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cron",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cron"]
            },
            "description": "What Vercel Cron calls. Finds users whose local hour equals delivery_hour right now and calls /api/generate for each. Returns {processed, succeeded, failed, skipped}. Writes a cron_runs row."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cron — missing secret (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cron",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cron"]
            },
            "description": "Negative case: also writes a cron_runs row with auth_ok=false."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.expect(pm.response.code).to.be.oneOf([401]));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "noauth"
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  }
}
