{
  "expo": {
    "name": "Panorist",
    "slug": "panorist",
    "scheme": "panorist",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f3ec",
    "ios": {
      "bundleIdentifier": "app.panorist",
      "supportsTablet": true
    },
    "android": {
      "package": "app.panorist",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f7f3ec"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#f7f3ec",
          "dark": { "backgroundColor": "#14120f" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
